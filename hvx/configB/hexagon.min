NO_QURT_INC = 1
SGMD ?= 64
CC_FLAGS += -DSGM_D=$(SGMD)
CXX_FLAGS += -DSGM_D=$(SGMD)
UTILS_DIR=$(HEXAGON_SDK_ROOT)/utils/examples

BUILD_LIBS += libsgmms_skel
BUILD_DLLS += libsgmms_skel

libsgmms_skel_QAICIDLS += inc/sgmms
libsgmms_skel_C_SRCS += $(OBJ_DIR)/sgmms_skel
libsgmms_skel.C_SRCS += src/sgmms_imp.c
libsgmms_skel_LD_FLAGS += -L$(HEXAGON_SDK_ROOT)/libs/worker_pool/hexagon_Release_toolv19_v73 -lworker_pool


BUILD_COPIES += \
   $(DLLS) \
   $(EXES) \
   $(LIBS) \
   $(SHIP_DIR)/ ;
